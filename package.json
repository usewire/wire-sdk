{
  "name": "@usewire/sdk",
  "version": "0.17.0",
  "description": "Connect Wire context containers to your agent, harness, or AI infrastructure.",
  "license": "MIT",
  "author": "Wire (Superloops LLC)",
  "homepage": "https://usewire.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/usewire/wire-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/usewire/wire-sdk/issues"
  },
  "keywords": [
    "wire",
    "mcp",
    "agents",
    "context",
    "memory"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "agent": [
        "./dist/agent/index.d.ts"
      ],
      "app": [
        "./dist/app/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-vendor.mjs",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "vendor:manifest": "scripts/vendor-manifest.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "jose": "^6.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
